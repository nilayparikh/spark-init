# ── .env.secrets.example ──────────────────────────────────────────────────────
# Template for secrets. Copy to .env.secrets and fill in your values.
# .env.secrets is git-ignored — this .example file is tracked as a reference.
#
# Interpolation order at runtime (later files override earlier):
#   .env → .env.secrets
#
# Usage:
#   cp .env.secrets.example .env.secrets   # edit with your real values
#   docker compose --env-file .env --env-file .env.secrets up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── Database Credentials ─────────────────────────────────────────────────────
DATA_POSTGRES_PASSWORD=change_me_postgres
GRAFANA_DB_PASSWORD=change_me_grafana_db
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
INTERFACE_DB_PASSWORD=change_me_litellm_db

# ── LiteLLM Proxy Auth ───────────────────────────────────────────────────────
# Master key used for all API calls to the proxy.
LITELLM_MASTER_KEY=sk-change-me-to-a-random-string

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ── Cloud Provider API Keys (leave empty to disable that provider) ───────────
MICROSOFT_FOUNDRY_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_ZEN_API_KEY=

# ── Auth Tokens (used by claude-code.sh, not by compose) ─────────────────────
HF_TOKEN=
GH_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=