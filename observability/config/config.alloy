  }

  rule {
    target_label = "instance"
    replacement  = "llama-server:8080"
  }

  rule {
    target_label = "job"
    replacement  = "interface-llm"
  }

  rule {
    target_label = "provider_family"
    replacement  = "llamacpp"
  }

  rule {
    target_label = "interface_name"
    replacement  = "llama-mtp"
  }

  rule {
    target_label = "profile_name"
    replacement  = "llama-qwen-3-6-27b"
  }

  rule {
    target_label = "interface_instance"
    replacement  = "llama-mtp-local"
  }

  rule {
    target_label = "service_name"
    replacement  = "llama-server"
  }

  rule {
    target_label = "model_alias"
    replacement  = "qwen3.6_27b"
  }

  rule {
    target_label = "telemetry_scope"
    replacement  = "interface"
  }
}

prometheus.scrape "llamacpp" {
  targets = discovery.relabel.llamacpp_metrics_target.output

  forward_to      = [prometheus.relabel.llamacpp_metrics.receiver]
  job_name        = "llamacpp-native"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

prometheus.relabel "vllm_primary_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster_tenant"
    replacement  = "spark_dgx_core"
  }

  rule {
    target_label = "environment"
    replacement  = "personal"
  }

  rule {
    target_label = "stack"
    replacement  = "observability-core"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
