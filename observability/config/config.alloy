prometheus.scrape "vllm_secondary" {
  targets = discovery.relabel.vllm_secondary_metrics_target.output

  forward_to      = [prometheus.relabel.vllm_secondary_metrics.receiver]
  job_name        = "vllm-secondary"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "litellm_metrics_target" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    action        = "keep"
    regex         = "init"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    action        = "keep"
    regex         = "litellm"
  }

  rule {
    target_label = "__address__"
    replacement  = "litellm:4000"
  }
}

discovery.relabel "llamacpp_metrics_target" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    action        = "keep"
    regex         = "init"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    action        = "keep"
    regex         = "llama-qwen-3-6-27b"
  }

  rule {
    target_label = "__address__"
    replacement  = "llama-qwen-3-6-27b:8080"
  }
}

discovery.relabel "vllm_primary_metrics_target" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    action        = "keep"
    regex         = "init"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    action        = "keep"
    regex         = "vllm-qwen-3-6-27b"
  }

  rule {
    target_label = "__address__"
    replacement  = "host.docker.internal:8000"
  }
}

discovery.relabel "vllm_secondary_metrics_target" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    action        = "keep"
    regex         = "init"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    action        = "keep"
    regex         = "vllm-qwen-3-6-35b-a3b"
  }

  rule {
    target_label = "__address__"
    replacement  = "host.docker.internal:8001"
  }
}

loki.relabel "docker_metadata" {
  forward_to = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_name"]
    regex         = "(.+)"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "(.+)"
    target_label  = "compose_project"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_init_profile_name"]
    regex         = "(.+)"
    target_label  = "profile_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service_name"
    replacement   = "$1"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.write.local.receiver]

  labels = {
    cluster_tenant = "spark_dgx_core",
    environment    = "personal",
    stack          = "observability-core",
    host           = "barsana",
    site           = "barsana",
    role           = "spark-dgx",
    job            = "machine-docker",
    source_type    = "docker",
    log_domain     = "container",
    log_category   = "service-console",
    vendor         = "docker",
  }

  relabel_rules = loki.relabel.docker_metadata.rules
}

loki.relabel "journal_metadata" {
  forward_to = []

  rule {
    target_label = "job"
    replacement  = "machine-journal"
  }

  rule {
    target_label = "host"
    replacement  = "barsana"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
    replacement  = "spark-dgx"
  }

  rule {
    target_label = "source_type"
    replacement  = "journal"
  }

  rule {
    target_label = "log_domain"
    replacement  = "service"
  }

  rule {
    target_label = "log_category"
    replacement  = "system-service"
  }

  rule {
    target_label = "vendor"
    replacement  = "linux"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "journal_host"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "priority"
  }

  rule {
    source_labels = ["__journal__transport"]
    regex         = "kernel"
    target_label  = "log_domain"
    replacement   = "kernel"
  }

  rule {
    source_labels = ["__journal__transport"]
    regex         = "kernel"
    target_label  = "log_category"
    replacement   = "kernel"
  }

  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    separator     = ";"
    regex         = "(?i).*(nvidia|nvml|nvrm|dcgm|cuda).*"
    target_label  = "vendor"
    replacement   = "nvidia"
  }

  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    separator     = ";"
    regex         = "(?i).*(nvidia|nvml|nvrm|dcgm|cuda).*"
    target_label  = "log_category"
    replacement   = "gpu-driver"
  }

  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    separator     = ";"
    regex         = "(?i).*(docker|containerd|podman|cri-o|nerdctl).*"
    target_label  = "vendor"
    replacement   = "container"
  }

  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    separator     = ";"
    regex         = "(?i).*(docker|containerd|podman|cri-o|nerdctl).*"
    target_label  = "log_category"
    replacement   = "container-runtime"
  }
}

// The systemd journal is the primary Linux and NVIDIA log source on this host.
loki.source.journal "system" {
  path      = "/host/root/var/log/journal"
  max_age   = "12h"
  forward_to = [loki.write.local.receiver]

  labels = {
    cluster_tenant = "spark_dgx_core",
    environment    = "personal",
    stack          = "observability-core",
  }

  relabel_rules = loki.relabel.journal_metadata.rules
}

// File tails complement journald for Ubuntu installer and maintenance logs.
loki.source.file "ubuntu_text_logs" {
  targets = [
    {
      __path__       = "/host/root/var/log/cloud-init.log",
      job            = "ubuntu-cloud-init",
      service_name   = "cloud-init",
      log_category   = "cloud-init",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
      __path__       = "/host/root/var/log/cloud-init-output.log",
      job            = "ubuntu-cloud-init",
      service_name   = "cloud-init",
      log_category   = "cloud-init",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
      __path__       = "/host/root/var/log/dpkg.log",
      job            = "ubuntu-dpkg",
      service_name   = "dpkg",
      log_category   = "package-management",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
      __path__       = "/host/root/var/log/apt/history.log",
      job            = "ubuntu-apt",
      service_name   = "apt",
      log_category   = "package-management",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
      __path__       = "/host/root/var/log/apt/term.log",
      job            = "ubuntu-apt",
      service_name   = "apt",
      log_category   = "package-management",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
      __path__       = "/host/root/var/log/installer/curtin-install.log",
      job            = "ubuntu-installer",
      service_name   = "curtin",
      log_category   = "installer",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
      __path__       = "/host/root/var/log/installer/installer-journal.txt",
      job            = "ubuntu-installer",
      service_name   = "installer-journal",
      log_category   = "installer",
      source_type    = "file",
      host           = "barsana",
      site           = "barsana",
      role           = "spark-dgx",
      cluster_tenant = "spark_dgx_core",
      environment    = "personal",
      stack          = "observability-core",
    },
    {
