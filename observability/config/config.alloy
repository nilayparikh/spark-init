// ── Grafana Alloy Configuration ────────────────────────────────────────────
// This file defines the full observability pipeline:
//   1. Collect: Unix exporter (host), DCGM (GPU), cAdvisor (containers),
//               Docker discovery (LiteLLM, llama.cpp metrics),
//               Docker logs (stdout/stderr), systemd journal
//   2. Relabel: Enrich all metrics and logs with standard labels for
//               cross-service correlation in Grafana
//   3. Forward: Metrics → Mimir, Logs → Loki
//
// Label Conventions (for AI agents reading this file):
//   cluster_tenant  – logical tenant group ("spark_dgx_core")
//   environment     – deployment stage ("personal")
//   stack           – observability stack name ("observability-core")
//   site            – physical/logical site
//   role            – machine role ("spark-dgx")
//   host            – stable machine identifier
//   job             – normalized collector name
//     machine-linux     – host telemetry (CPU, memory, disk)
//     machine-docker    – container telemetry (cAdvisor)
//     machine-gpu       – GPU telemetry (DCGM)
//     interface-llm     – inference metrics (LiteLLM + llama.cpp)
//     machine-journal   – systemd journal logs
//     ubuntu-*          – OS maintenance logs
//   log_domain      – "kernel" or "service"
//   log_category     – kernel, system-service, gpu-driver, container-runtime
//   vendor           – linux, nvidia, container
//
// For humans: skip these details. The Grafana dashboards work out of the box.
// This comment exists for AI coding agents who need to extend the pipeline.
// ────────────────────────────────────────────────────────────────────────────

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  disable_collectors = ["mdadm", "zfs"]
}

prometheus.relabel "host_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster_tenant"
    replacement  = "spark_dgx_core"
  }

  rule {
    target_label = "environment"
    replacement  = "personal"
  }

  rule {
    target_label = "stack"
    replacement  = "observability-core"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
    replacement  = "spark-dgx"
  }

  rule {
    target_label = "host"
    replacement  = "barsana"
  }

  rule {
    target_label = "instance"
    replacement  = "barsana"
  }

  rule {
    target_label = "job"
    replacement  = "machine-linux"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.host_metrics.receiver]
  job_name        = "host-unix"
  scrape_interval = "5s"
  scrape_timeout  = "4s"
}

prometheus.relabel "gpu_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster_tenant"
    replacement  = "spark_dgx_core"
  }

  rule {
    target_label = "environment"
    replacement  = "personal"
  }

  rule {
    target_label = "stack"
    replacement  = "observability-core"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
    replacement  = "spark-dgx"
  }

  rule {
    target_label = "host"
    replacement  = "barsana"
  }

  rule {
    target_label = "instance"
    replacement  = "barsana"
  }

  rule {
    target_label = "job"
    replacement  = "machine-gpu"
  }
}

prometheus.scrape "gpu" {
  targets = [
    {
      __address__ = "gpu-telemetry:9400",
    },
  ]

  forward_to      = [prometheus.relabel.gpu_metrics.receiver]
  job_name        = "gpu-dcgm"
  scrape_interval = "5s"
  scrape_timeout  = "4s"
}

prometheus.relabel "docker_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster_tenant"
    replacement  = "spark_dgx_core"
  }

  rule {
    target_label = "environment"
    replacement  = "personal"
  }

  rule {
    target_label = "stack"
    replacement  = "observability-core"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
    replacement  = "spark-dgx"
  }

  rule {
    target_label = "host"
    replacement  = "barsana"
  }

  rule {
    target_label = "instance"
    replacement  = "barsana-docker"
  }

  rule {
    target_label = "job"
    replacement  = "machine-docker"
  }

  rule {
    target_label = "telemetry_scope"
    replacement  = "docker"
  }

  rule {
    source_labels = ["name"]
    regex         = "/?(.*)"
    target_label  = "container_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_name"]
    regex         = "(.+)"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    regex         = "(.+)"
    target_label  = "compose_project"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_label_init_profile_name"]
    regex         = "(.+)"
    target_label  = "profile_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    action = "labeldrop"
    regex  = "container_label_.*|id|name"
  }
}

prometheus.scrape "docker" {
  targets = [
    {
      __address__ = "cadvisor:8080",
    },
  ]

  forward_to      = [prometheus.relabel.docker_metrics.receiver]
  job_name        = "docker-cadvisor"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

prometheus.relabel "litellm_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster_tenant"
    replacement  = "spark_dgx_core"
  }

  rule {
    target_label = "environment"
    replacement  = "personal"
  }

  rule {
    target_label = "stack"
    replacement  = "observability-core"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
    replacement  = "spark-dgx"
  }

  rule {
    target_label = "host"
    replacement  = "barsana"
  }

  rule {
    target_label = "instance"
    replacement  = "llama-mtp-local"
  }

  rule {
    target_label = "job"
    replacement  = "interface-llm"
  }

  rule {
    target_label = "provider_family"
    replacement  = "litellm"
  }

  rule {
    target_label = "interface_name"
    replacement  = "llama-mtp"
  }

  rule {
    target_label = "profile_name"
    replacement  = "interface"
  }

  rule {
    target_label = "interface_instance"
    replacement  = "llama-mtp-local"
  }

  rule {
    target_label = "service_name"
    replacement  = "litellm"
  }

  rule {
    target_label = "model_alias"
    replacement  = "qwen3.6_27b"
  }

  rule {
    target_label = "telemetry_scope"
    replacement  = "interface"
  }

  rule {
    action = "labeldrop"
    regex  = "client_ip|end_user|hashed_api_key|api_key_alias|org_alias|org_id|team|team_alias|user|user_agent|user_email"
  }
}

prometheus.scrape "litellm" {
  targets = discovery.relabel.litellm_metrics_target.output

  forward_to      = [prometheus.relabel.litellm_metrics.receiver]
  job_name        = "litellm-interface"
  metrics_path    = "/metrics/"
  scrape_interval = "30s"
  scrape_timeout  = "25s"
}

