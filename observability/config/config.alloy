prometheus.relabel "vllm_secondary_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "cluster_tenant"
    replacement  = "spark_dgx_core"
  }

  rule {
    target_label = "environment"
    replacement  = "personal"
  }

  rule {
    target_label = "stack"
    replacement  = "observability-core"
  }

  rule {
    target_label = "site"
    replacement  = "barsana"
  }

  rule {
    target_label = "role"
