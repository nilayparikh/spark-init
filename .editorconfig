# EditorConfig: consistent coding standards across editors
# https://EditorConfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files (docs, README, etc.)
[*.{md,mkd,mdown,markdown}]
indent_size = 2

# YAML files (Docker Compose, GitHub Actions, configs)
[*.{yml,yaml}]
indent_size = 2

# JSON files (including VS Code settings)
[*.{json,jsonc}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Python files (scripts, tests)
[*.py]
indent_size = 4
