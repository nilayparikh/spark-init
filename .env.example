# Copy this file to .env and fill in the secrets locally.
# Do not commit .env.

# Compose profile selection
# This is the primary stack switchboard for the repository.
# Set the full active stack shape here before running `docker compose up -d`.
# Example active shape for this repo:
#   data,obs,interface,llama-qwen-3-6-27b,llama-qwen-3-6-35b-a3b
COMPOSE_PROFILES=data,obs,interface,llama-qwen-3-6-27b,llama-qwen-3-6-35b-a3b

# General
# Hugging Face token used by the interface and other HF-connected services.
HF_TOKEN=

# GitHub Personal Access Token for GitHub CLI and plugin access.
GH_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Local llama.cpp build tag.
LLAMA_CPP_TAG=b9222

# Cloudflare Tunnel for exposing local services to the internet.
# Used by OpenAI-compatible endpoints and remote access.
CLOUDFLARE_TUNNEL_TOKEN=

# Data / Postgres
DATA_POSTGRES_IMAGE=postgres:latest
DATA_POSTGRES_CONTAINER_NAME=postgres
DATA_POSTGRES_BIND_HOST=0.0.0.0
DATA_POSTGRES_PORT=5432
DATA_POSTGRES_DB=platform
DATA_POSTGRES_USER=platform_admin
DATA_POSTGRES_PASSWORD=platform_admin_local
DATA_POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata

# Observability / Grafana
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=grafana_local_obsv
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_observability_admin
GRAFANA_DOMAIN=barsana.local
GRAFANA_ROOT_URL=http://barsana.local:3000/
LOKI_RETENTION_PERIOD=2d
MIMIR_RETENTION_PERIOD=7d

# LiteLLM interface
# Compose provides defaults for the rest of the interface stack.
# Override only values here when you want to customize the interface runtime.
LITELLM_MASTER_KEY=sk-d3k5Zz9gWxUTBcTO5fZw4uiiDmgrsDztpkXR84fJnUTnN0NB067cSgT1ru2Wdfro
LITELLM_NO_DOCS="True"
LITELLM_NO_REDOC="True"
INTERFACE_DB_NAME=litellm_interface
INTERFACE_DB_USER=litellm_interface
INTERFACE_DB_PASSWORD=litellm_interface_local
INTERFACE_DATABASE_URL=postgresql://litellm_interface:litellm_interface_local@postgres:5432/litellm_interface

# DGX Spark M (Qwen 3.6 27B) interface proxy settings.
DGX_SPARK_M_BASE_URL=http://host.docker.internal:8000/v1
DGX_SPARK_M_API_KEY=sk-dummy
DGX_SPARK_M_MODEL=openai/qwen3.6_27b

# DGX Spark S (Qwen 3.6 35B A3B) interface proxy settings.
DGX_SPARK_S_BASE_URL=http://host.docker.internal:8001/v1
DGX_SPARK_S_API_KEY=sk-dummy
DGX_SPARK_S_MODEL=openai/qwen3.6_35b_a3b

# Microsoft Foundry orchestrator model exposed through LiteLLM.
MICROSOFT_FOUNDRY_API_BASE=https://tuts.services.ai.azure.com/openai/v1
MICROSOFT_FOUNDRY_API_KEY=

# OpenCode Zen API
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=

# NVIDIA Interfaces
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Deepseek API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Local llama.cpp configuration
LLAMA_CPP_TAG=b9381

# Local llama-qwen-3-6-27b model paths
LLAMA_QWEN_3_6_27B_GGUF_MODEL_PATH="/home/nilayparikh/.sources/.init/models/qwen3.6-27b-text-nvfp4-mtp/qwen3.6-27b-text-nvfp4-mtp.gguf"
LLAMA_QWEN_3_6_27B_HOST_PORT=8000
LLAMA_QWEN_3_6_27B_SCRIPT_PORT=8000

# Local llama-qwen-3-6-35b-a3b model paths
LLAMA_QWEN_3_6_35B_A3B_GGUF_MODEL_PATH="/home/nilayparikh/.sources/.init/models/qwen3.6-35b-a3b-nvfp4-mtp/qwen3.6-35b-a3b-nvfp4-mtp.gguf"
LLAMA_QWEN_3_6_35B_A3B_MMPROJ_MODEL_PATH="/home/nilayparikh/.sources/.init/models/qwen3.6-35b-a3b-nvfp4-mtp/mmproj-BF16.gguf"
LLAMA_QWEN_3_6_35B_A3B_HOST_PORT=8001
LLAMA_QWEN_3_6_35B_A3B_CONTAINER_PORT=8080
