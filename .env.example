# ── .env.example ──────────────────────────────────────────────────────────────
# Canonical reference for all configurable variables.
# This file is tracked in git — update it whenever you add or rename a variable.
#
# ── Layered .env Architecture ─────────────────────────────────────────────────
#
# .env.example       → Template for new setups (tracked in git, NOT used at runtime)
# .env               → Your active config: profiles, model paths, hostnames (git-ignored)
# .env.secrets       → Your API keys, tokens, passwords (NEVER committed)
#
# Interpolation order at runtime (later files override earlier):
#   .env → .env.secrets
#
# Quickstart (new setup):
#   cp .env.example .env                 # edit with your paths/hostname
#   cp .env.secrets.example .env.secrets # edit with your real secrets
#   docker compose --env-file .env --env-file .env.secrets up -d
#
# Sections:
#   1. Stack Profile
#   2. Secrets (set in .env.secrets; never commit values)
#   3. Deployment Configuration
#   4. Inference Engine Tuning
#   5. LiteLLM Router
#   6. Observability Pipeline
#   7. Claude Code Container
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. Stack Profile ─────────────────────────────────────────────────────────
# Primary switchboard. Set the active stack shape before running
# `docker compose up -d`. Each service also has its own unique profile.
#
# Common combinations:
#   all                          — everything
#   data,obs,interface           — full stack (LiteLLM + both llama.cpp backends)
#   data,litellm,llama-qwen-3-6-27b — LiteLLM + 27B only
#   data,obs                     — telemetry only (no inference)
#   data,litellm                 — API proxy only (cloud models)
#   data                         — just PostgreSQL
COMPOSE_PROFILES=data,obs,interface

# ── 2. Secrets (set in .env.secrets; never commit values) ────────────────────
# Template values are in .env.secrets.example.
# Copy: cp .env.secrets.example .env.secrets

# 2a. Database credentials
DATA_POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
INTERFACE_DB_PASSWORD=

# 2b. LiteLLM proxy auth
LITELLM_MASTER_KEY=

# 2c. Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# 2d. Cloud provider API keys (leave empty to disable that provider)
MICROSOFT_FOUNDRY_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_ZEN_API_KEY=

# 2e. Auth tokens (used by claude-code.sh, not by compose)
HF_TOKEN=
GH_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── 3. Deployment Configuration ──────────────────────────────────────────────

# 3a. Container images & names
DATA_POSTGRES_IMAGE=postgres:latest
DATA_POSTGRES_CONTAINER_NAME=postgres

# 3b. Database configuration
DATA_POSTGRES_BIND_HOST=0.0.0.0
DATA_POSTGRES_PORT=5432
DATA_POSTGRES_DB=platform
DATA_POSTGRES_USER=platform_admin
DATA_POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
INTERFACE_DB_NAME=litellm_interface
INTERFACE_DB_USER=litellm_interface
# Connection string for LiteLLM → PostgreSQL. Password comes from .env.secrets via INTERFACE_DB_PASSWORD.
INTERFACE_DATABASE_URL=postgresql://litellm_interface:${INTERFACE_DB_PASSWORD}@postgres:5432/litellm_interface

# 3c. Grafana
GRAFANA_ADMIN_USER=admin
# Set these to your host's domain or IP, e.g.:
#   GRAFANA_DOMAIN=myhost.local
#   GRAFANA_ROOT_URL=http://myhost.local:3000/
GRAFANA_DOMAIN=change_me_to_your_hostname
GRAFANA_ROOT_URL=http://change_me_to_your_hostname:3000/

# 3d. LiteLLM proxy
LITELLM_NO_DOCS="True"
LITELLM_NO_REDOC="True"

# 3e. Local llama.cpp build
LLAMA_CPP_TAG=b9381

# 3f. Local llama.cpp model paths (must point to valid GGUF files on disk)
# Example (replace with your actual paths):
#   LLAMA_QWEN_3_6_27B_GGUF_MODEL_PATH="/path/to/models/qwen3.6-27b-text-nvfp4-mtp/qwen3.6-27b-text-nvfp4-mtp.gguf"
LLAMA_QWEN_3_6_27B_GGUF_MODEL_PATH="/path/to/your/models/qwen3.6-27b-text-nvfp4-mtp/qwen3.6-27b-text-nvfp4-mtp.gguf"
# Bind host controls which network interface to listen on (0.0.0.0 = all interfaces)
LLAMA_QWEN_3_6_27B_BIND_HOST=0.0.0.0
LLAMA_QWEN_3_6_27B_HOST_PORT=8000
LLAMA_QWEN_3_6_27B_CONTAINER_PORT=8080
LLAMA_QWEN_3_6_35B_A3B_GGUF_MODEL_PATH="/path/to/your/models/qwen3.6-35b-a3b-nvfp4-mtp/qwen3.6-35b-a3b-nvfp4-mtp.gguf"
LLAMA_QWEN_3_6_35B_A3B_MMPROJ_MODEL_PATH="/path/to/your/models/qwen3.6-35b-a3b-nvfp4-mtp/mmproj-BF16.gguf"
LLAMA_QWEN_3_6_35B_A3B_BIND_HOST=0.0.0.0
LLAMA_QWEN_3_6_35B_A3B_HOST_PORT=8001
LLAMA_QWEN_3_6_35B_A3B_CONTAINER_PORT=8080

# 3g. LiteLLM → llama.cpp proxy routing
DGX_SPARK_M_BASE_URL=http://host.docker.internal:8000/v1
DGX_SPARK_M_API_KEY=sk-dummy
DGX_SPARK_M_MODEL=openai/qwen3.6_27b
DGX_SPARK_S_BASE_URL=http://host.docker.internal:8001/v1
DGX_SPARK_S_API_KEY=sk-dummy
DGX_SPARK_S_MODEL=openai/qwen3.6_35b_a3b

# 3h. Cloud provider base URLs
MICROSOFT_FOUNDRY_API_BASE=https://tuts.services.ai.azure.com/openai/v1
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 4. Inference Engine Tuning ───────────────────────────────────────────────
# These variables drive llama.cpp CLI flags in docker-compose.interface.yml.
# LiteLLM model_info values (context_window, max_tokens, etc.) are now hardcoded
# in interfaces/config/litellm/providers/dgx-spark.yaml — see that file for
# the canonical model parameter values.

# 4a. Qwen 3.6 27B (.INIT/Pro)
INFERENCE_QWEN_27B_CONTEXT_SIZE=131072
INFERENCE_QWEN_27B_MAX_INPUT_TOKENS=114688
INFERENCE_QWEN_27B_REASONING_BUDGET=8192
INFERENCE_QWEN_27B_BATCH_SIZE=2048
INFERENCE_QWEN_27B_UBATCH_SIZE=512
INFERENCE_QWEN_27B_THREADS=8
INFERENCE_QWEN_27B_THREADS_BATCH=8
INFERENCE_QWEN_27B_SPEC_DRAFT_N_MAX=3
INFERENCE_QWEN_27B_SPEC_DRAFT_P_MIN=0.88
INFERENCE_QWEN_27B_SPEC_DRAFT_NGL=99
INFERENCE_QWEN_27B_MIN_P=0.05
INFERENCE_QWEN_27B_LLAMA_TIMEOUT=120

# 4b. Qwen 3.6 35B A3B (.INIT/Flash)
INFERENCE_QWEN_35B_A3B_CONTEXT_SIZE=262144
INFERENCE_QWEN_35B_A3B_MAX_INPUT_TOKENS=245760
INFERENCE_QWEN_35B_A3B_REASONING_BUDGET=8192
INFERENCE_QWEN_35B_A3B_BATCH_SIZE=2048
INFERENCE_QWEN_35B_A3B_UBATCH_SIZE=512
INFERENCE_QWEN_35B_A3B_THREADS=8
INFERENCE_QWEN_35B_A3B_THREADS_BATCH=8
INFERENCE_QWEN_35B_A3B_SPEC_DRAFT_N_MAX=2
INFERENCE_QWEN_35B_A3B_KV_CACHE_TYPE_KEY=q8_0
INFERENCE_QWEN_35B_A3B_KV_CACHE_TYPE_VALUE=q8_0
INFERENCE_QWEN_35B_A3B_LLAMA_TIMEOUT=120

# ── 5. LiteLLM Router ────────────────────────────────────────────────────────
# Controls retry behavior, model aliasing, and logging in config.yaml.
# Values are referenced via os.environ/ in LiteLLM's YAML config.

LITELLM_NUM_RETRIES=5
LITELLM_RETRY_AFTER=0
LITELLM_TIMEOUT_ERROR_RETRIES=5
LITELLM_RATE_LIMIT_ERROR_RETRIES=5
LITELLM_INTERNAL_ERROR_RETRIES=5
LITELLM_MODEL_ALIAS_ULTRA="OpenCodeZen/BIG-PICKLE"
LITELLM_MODEL_ALIAS_PRO="DGX/Qwen3.6-27B"
LITELLM_MODEL_ALIAS_FLASH="DGX/Qwen3.6-35B-A3B"
LITELLM_MODEL_ALIAS_AIR="DGX/Qwen3.6-35B-A3B"
LITELLM_JSON_LOGS=true
LITELLM_DROP_PARAMS=true
LITELLM_REDACT_USER_API_KEY=true
LITELLM_REQUIRE_AUTH_METRICS=false
LITELLM_TURN_OFF_MSG_LOGGING=false
LITELLM_STREAM_USAGE=true

# ── 6. Observability Pipeline ────────────────────────────────────────────────
# Infrastructure identity labels shared across Alloy, alerts, and dashboards.
# Changing OBSERVABILITY_HOST updates ~40 references in one place.

# 6a. Infrastructure identity
# Set these to your own hostname/labels, e.g.:
#   OBSERVABILITY_HOST=myhost
#   OBSERVABILITY_SITE=myhost
OBSERVABILITY_HOST=change_me_to_your_hostname
OBSERVABILITY_SITE=change_me_to_your_hostname
OBSERVABILITY_ENVIRONMENT=personal
OBSERVABILITY_ROLE=spark-dgx
OBSERVABILITY_CLUSTER_TENANT=spark_dgx_core
OBSERVABILITY_STACK=observability-core

# 6b. Scrape intervals (format: "5s", "15s", "30s")
OBSERVABILITY_SCRAPE_INTERVAL_HOST=5s
OBSERVABILITY_SCRAPE_TIMEOUT_HOST=4s
OBSERVABILITY_SCRAPE_INTERVAL_GPU=5s
OBSERVABILITY_SCRAPE_TIMEOUT_GPU=4s
OBSERVABILITY_SCRAPE_INTERVAL_DOCKER=15s
OBSERVABILITY_SCRAPE_TIMEOUT_DOCKER=10s
OBSERVABILITY_SCRAPE_INTERVAL_LLAMACPP=15s
OBSERVABILITY_SCRAPE_TIMEOUT_LLAMACPP=10s
OBSERVABILITY_SCRAPE_INTERVAL_LITELLM=30s
OBSERVABILITY_SCRAPE_TIMEOUT_LITELLM=25s
OBSERVABILITY_SCRAPE_INTERVAL_VLLM=15s
OBSERVABILITY_SCRAPE_TIMEOUT_VLLM=10s

# 6c. Service ports (used by Mimir/Loki configs, Alloy remote write, Grafana datasources)
OBSERVABILITY_MIMIR_HTTP_PORT=9009
OBSERVABILITY_LOKI_HTTP_PORT=3100
OBSERVABILITY_LOKI_GRPC_PORT=9096

# 6d. Service log levels
OBSERVABILITY_MIMIR_LOG_LEVEL=warn
OBSERVABILITY_LOKI_LOG_LEVEL=warn

# 6e. Loki compaction
OBSERVABILITY_LOKI_COMPACTION_INTERVAL=10m

# 6f. Journal collection
OBSERVABILITY_JOURNAL_MAX_AGE=12h

# 6g. Grafana provisioning
OBSERVABILITY_DASHBOARD_UPDATE_INTERVAL=30
OBSERVABILITY_GRAFANA_MAX_LINES=1000

# 6h. Retention periods
LOKI_RETENTION_PERIOD=2d
MIMIR_RETENTION_PERIOD=7d

# ── 7. Claude Code Container ─────────────────────────────────────────────────
# Used by claude-code.sh to launch an isolated Claude Code container routed
# through the LiteLLM proxy. Override these to target a different registry
# or model routing.

# Replace with your own registry, e.g.:
#   CLAUDE_CODE_REGISTRY=ghcr.io/your-org
CLAUDE_CODE_REGISTRY=ghcr.io/your-org
CLAUDE_CODE_IMAGE_NAME=claude-code
CLAUDE_CODE_IMAGE_TAG=latest
CLAUDE_CODE_CONTAINER_NAME=claude-dev-workspace
# Set this to your LiteLLM proxy URL, e.g.:
#   CLAUDE_CODE_MODEL_BASE_URL=http://myhost.local:4000
CLAUDE_CODE_MODEL_BASE_URL=http://change_me_to_your_hostname:4000
CLAUDE_CODE_COLUMNS=80
CLAUDE_CODE_LINES=24
