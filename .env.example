# Copy this file to .env and fill in the secrets locally.
# Do not commit .env.

# Compose profile selection
# This is the primary stack switchboard. Set the full active stack shape here,
# then run `docker compose up -d` from the repository root.
# Example shapes:
#   data,obs,interface,llama-qwen-3-6-27b
#   data,interface,vllm-qwen-3-6-27b
#   data,obs,interface,vllm-qwen-3-6-27b
#   data,vllm-qwen-3-6-35b-a3b
COMPOSE_PROFILES=data,obs,interface,llama-qwen-3-6-27b

# General
HF_TOKEN=
LLAMA_CPP_TAG=b9222

# Data / Postgres
DATA_POSTGRES_IMAGE=postgres:latest
DATA_POSTGRES_CONTAINER_NAME=postgres
DATA_POSTGRES_BIND_HOST=0.0.0.0
DATA_POSTGRES_PORT=5432
DATA_POSTGRES_DB=platform
DATA_POSTGRES_USER=platform_admin
DATA_POSTGRES_PASSWORD=platform_admin_local
DATA_POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata

# Observability / Grafana
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=grafana_local_obsv
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_observability_admin
GRAFANA_DOMAIN=barsana.local
GRAFANA_ROOT_URL=http://barsana.local:3000/
LOKI_RETENTION_PERIOD=2d
MIMIR_RETENTION_PERIOD=7d

# LiteLLM interface
# Compose provides defaults for the rest of the interface stack.
# Keep only the common overrides and secrets here; add advanced env vars only
# when you actually want to override a compose default.
LITELLM_MASTER_KEY=sk-interface-ui-local
INTERFACE_DB_NAME=litellm_interface
INTERFACE_DB_USER=litellm_interface
INTERFACE_DB_PASSWORD=litellm_interface_local
INTERFACE_DATABASE_URL=postgresql://litellm_interface:litellm_interface_local@postgres:5432/litellm_interface
INTERFACE_QWEN_3_6_27B_BASE_URL=http://host.docker.internal:8000/v1
INTERFACE_QWEN_3_6_27B_API_KEY=sk-dummy
INTERFACE_QWEN_3_6_27B_MODEL=openai/qwen3.6_27b

# Azure orchestrator model exposed through LiteLLM.
AZURE_ORCHESTRATOR_API_BASE=https://tuts.services.ai.azure.com/openai/v1
AZURE_ORCHESTRATOR_API_KEY=
AZURE_ORCHESTRATOR_MODEL=openai/Kimi-K2.6-1

# llama-qwen-3-6-27b
# Keep this mutually exclusive with vllm-qwen-3-6-27b because both use host port 8000.
LLAMA_QWEN_3_6_27B_GGUF_MODEL_PATH=/home/nilayparikh/.sources/.init/models/qwen3.6-27b-text-nvfp4-mtp/gguf/qwen3.6-27b-text-nvfp4-mtp.gguf
LLAMA_QWEN_3_6_27B_BINARY_PATH=/home/nilayparikh/.sources/.init/interfaces/llama-cpp/build/bin/llama-server
LLAMA_QWEN_3_6_27B_HOST_PORT=8000
LLAMA_QWEN_3_6_27B_SCRIPT_PORT=8000

# Shared vLLM runtime

# vllm-qwen-3-6-27b
VLLM_QWEN_3_6_27B_IMAGE=nilayparikh/vllm-spark:v05-26

# vllm-qwen-3-6-35b-a3b
VLLM_QWEN_3_6_35B_A3B_MODEL_PATH=/home/nilayparikh/.sources/.init/models/safetensors/sakamakismile-qwen3.6-35b-a3b-nvfp4
VLLM_QWEN_3_6_35B_A3B_PORT=8001
VLLM_QWEN_3_6_35B_A3B_MAX_MODEL_LEN=100352
VLLM_QWEN_3_6_35B_A3B_GPU_MEMORY_UTILIZATION=0.40
